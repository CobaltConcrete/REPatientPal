# Get a Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Current Gemini model used for image understanding and translation
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_MB=8
LOG_LEVEL=INFO

# Set this to your Render Static Site URL after creating the React frontend.
# Example: https://nightingaie.onrender.com
FRONTEND_ORIGIN=
